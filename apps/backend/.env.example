
# --- Database: Supabase ---
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432, IPv4).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Project Settings -> Database -> SSL -> download certificate, save next to the backend:
# DATABASE_SSL_CA=./supabase-ca.crt
# Supabase pooler allows a limited number of session connections; keep DB_POOL_MAX * instances under it.
# DB_POOL_MAX=10

# --- Razorpay Magic Checkout ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shipmozo (books Delhivery, generates labels) ---
# Panel -> Profile shows both keys. Set Delhivery in Settings -> Auto assign.
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
# Optional: defaults to the panel's default active warehouse.
SHIPMOZO_WAREHOUSE_ID=
# PIN code of the pickup warehouse, used for checkout serviceability checks.
SHIPMOZO_PICKUP_PINCODE=
SHIPMOZO_GSTIN=

# --- Firebase Authentication (phone OTP, Google, email link) ---
# Firebase console -> Project settings -> General -> Project ID.
FIREBASE_PROJECT_ID=

# --- Security ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to boot with missing or dev values.
JWT_SECRET=
COOKIE_SECRET=
# Same value in the storefront .env; lets it forward the visitor IP for rate limits.
STOREFRONT_PROXY_SECRET=
