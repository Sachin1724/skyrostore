NEXT_PUBLIC_MEDUSA_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_REGION_ID=
NEXT_PUBLIC_SALES_CHANNEL_ID=
NEXT_PUBLIC_SITE_URL=

# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web).
# These are public by design; security comes from Firebase's authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Production: our own HTTPS host (e.g. www.skyrostore.com), not
# <project>.firebaseapp.com: next.config.ts proxies /__/auth/* to Firebase so
# Google's account chooser shows our domain. Local http dev must keep
# <project>.firebaseapp.com (the SDK always uses https://<authDomain>).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
STOREFRONT_PROXY_SECRET=
# Same random value as the admin; protects /api/revalidate.
REVALIDATE_SECRET=
